id: "childless"
labels { text: "Childless couples: by choice (single bar) and infertility (double bar)" kind: LABEL_KIND_OTHER }
individuals { generation: 1 index: 1 gender: GENDER_MAN }
individuals { generation: 1 index: 2 gender: GENDER_WOMAN }
individuals { generation: 2 index: 1 gender: GENDER_WOMAN }
individuals { generation: 2 index: 2 gender: GENDER_MAN }
individuals { generation: 2 index: 3 gender: GENDER_MAN }
individuals { generation: 2 index: 4 gender: GENDER_WOMAN }
matings { partner_a { generation: 1 index: 1 } partner_b { generation: 1 index: 2 } offspring { child { generation: 2 index: 1 } } offspring { child { generation: 2 index: 2 } } }
matings { partner_a { generation: 2 index: 1 } partner_b { generation: 2 index: 3 } childlessness: CHILDLESSNESS_BY_CHOICE }
matings { partner_a { generation: 2 index: 2 } partner_b { generation: 2 index: 4 } childlessness: CHILDLESSNESS_INFERTILITY }
