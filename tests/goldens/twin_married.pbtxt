id: "twin_married"
labels { text: "The older of MZ twins marries in: birth order holds, the spouse stands outside the sibship" kind: LABEL_KIND_OTHER }
individuals { generation: 1 index: 1 gender: GENDER_MAN }
individuals { generation: 1 index: 2 gender: GENDER_WOMAN }
individuals { generation: 2 index: 1 gender: GENDER_MAN conditions { status: CONDITION_STATUS_AFFECTED } }
individuals { generation: 2 index: 2 gender: GENDER_MAN conditions { status: CONDITION_STATUS_AFFECTED } }
individuals { generation: 2 index: 3 gender: GENDER_WOMAN }
individuals { generation: 2 index: 4 gender: GENDER_WOMAN }
individuals { generation: 3 index: 1 gender: GENDER_WOMAN }
matings { partner_a { generation: 1 index: 1 } partner_b { generation: 1 index: 2 } offspring { child { generation: 2 index: 1 } twin_group: 1 twin_type: ZYGOSITY_TYPE_MONOZYGOTIC } offspring { child { generation: 2 index: 2 } twin_group: 1 twin_type: ZYGOSITY_TYPE_MONOZYGOTIC } offspring { child { generation: 2 index: 3 } } }
matings { partner_a { generation: 2 index: 1 } partner_b { generation: 2 index: 4 } offspring { child { generation: 3 index: 1 } } }
