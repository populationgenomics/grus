id: "compound-carrier"
labels { text: "HEXA and CFTR carriers (Bennett 2022 §4.5): two conditions divide in halves" kind: LABEL_KIND_OTHER }
individuals { generation: 1 index: 1 gender: GENDER_MAN conditions { name: "HEXA" status: CONDITION_STATUS_CARRIER } }
individuals { generation: 1 index: 2 gender: GENDER_WOMAN conditions { name: "HEXA" status: CONDITION_STATUS_CARRIER } conditions { name: "CFTR" status: CONDITION_STATUS_CARRIER } }
individuals { generation: 2 index: 1 gender: GENDER_MAN conditions { name: "CFTR" status: CONDITION_STATUS_CARRIER } }
individuals { generation: 2 index: 2 gender: GENDER_WOMAN conditions { name: "HEXA" status: CONDITION_STATUS_AFFECTED } proband: true }
individuals { generation: 2 index: 3 gender: GENDER_WOMAN conditions { name: "HEXA" status: CONDITION_STATUS_AFFECTED } conditions { name: "CFTR" status: CONDITION_STATUS_CARRIER } }
matings { partner_a { generation: 1 index: 1 } partner_b { generation: 1 index: 2 } offspring { child { generation: 2 index: 1 } } offspring { child { generation: 2 index: 2 } } offspring { child { generation: 2 index: 3 } } }
