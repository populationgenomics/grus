id: "founder-sibship-marry-in"
labels { text: "Two founder sibships joined by a marriage (the c19 gen-I shape)" kind: LABEL_KIND_OTHER }
individuals { generation: 1 index: 1 gender: GENDER_WOMAN }
individuals { generation: 1 index: 2 gender: GENDER_MAN }
individuals { generation: 1 index: 3 gender: GENDER_WOMAN }
individuals { generation: 1 index: 4 gender: GENDER_MAN }
individuals { generation: 2 index: 1 gender: GENDER_MAN }
individuals { generation: 2 index: 2 gender: GENDER_WOMAN conditions { status: CONDITION_STATUS_AFFECTED } }
matings { offspring { child { generation: 1 index: 1 } } offspring { child { generation: 1 index: 2 } } }
matings { offspring { child { generation: 1 index: 3 } } offspring { child { generation: 1 index: 4 } } }
matings { partner_a { generation: 1 index: 2 } partner_b { generation: 1 index: 3 } offspring { child { generation: 2 index: 1 } } offspring { child { generation: 2 index: 2 } } }
