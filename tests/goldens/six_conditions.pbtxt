id: "six-conditions"
labels { text: "Six conditions: sixth sections, one fixed wedge per condition" kind: LABEL_KIND_OTHER }
labels { text: "A" kind: LABEL_KIND_PHENOTYPE }
labels { text: "B" kind: LABEL_KIND_PHENOTYPE }
labels { text: "C" kind: LABEL_KIND_PHENOTYPE }
labels { text: "D" kind: LABEL_KIND_PHENOTYPE }
labels { text: "E" kind: LABEL_KIND_PHENOTYPE }
labels { text: "F" kind: LABEL_KIND_PHENOTYPE }
individuals { generation: 1 index: 1 gender: GENDER_MAN conditions { name: "A" status: CONDITION_STATUS_AFFECTED } }
individuals { generation: 1 index: 2 gender: GENDER_WOMAN conditions { name: "E" status: CONDITION_STATUS_CARRIER } conditions { name: "F" status: CONDITION_STATUS_CARRIER } }
