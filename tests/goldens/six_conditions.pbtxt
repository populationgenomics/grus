individuals { generation: 2 index: 4 gender: GENDER_MAN conditions { name: "E" status: CONDITION_STATUS_AFFECTED } }
individuals { generation: 2 index: 5 gender: GENDER_WOMAN conditions { name: "F" status: CONDITION_STATUS_CARRIER } conditions { name: "A" status: CONDITION_STATUS_PRESYMPTOMATIC } }
individuals { generation: 2 index: 6 gender: GENDER_NONBINARY }
individuals { generation: 3 index: 1 gender: GENDER_MAN conditions { name: "A" status: CONDITION_STATUS_CARRIER } conditions { name: "B" status: CONDITION_STATUS_CARRIER } conditions { name: "C" status: CONDITION_STATUS_CARRIER } conditions { name: "D" status: CONDITION_STATUS_CARRIER } conditions { name: "E" status: CONDITION_STATUS_CARRIER } conditions { name: "F" status: CONDITION_STATUS_CARRIER } }
individuals { generation: 3 index: 2 gender: GENDER_WOMAN conditions { name: "A" status: CONDITION_STATUS_AFFECTED } conditions { name: "B" status: CONDITION_STATUS_AFFECTED } conditions { name: "C" status: CONDITION_STATUS_AFFECTED } conditions { name: "D" status: CONDITION_STATUS_AFFECTED } conditions { name: "E" status: CONDITION_STATUS_AFFECTED } conditions { name: "F" status: CONDITION_STATUS_AFFECTED } }
individuals { generation: 3 index: 3 gender: GENDER_NONBINARY conditions { name: "A" status: CONDITION_STATUS_CARRIER } conditions { name: "B" status: CONDITION_STATUS_CARRIER } conditions { name: "C" status: CONDITION_STATUS_CARRIER } conditions { name: "D" status: CONDITION_STATUS_CARRIER } conditions { name: "E" status: CONDITION_STATUS_CARRIER } conditions { name: "F" status: CONDITION_STATUS_CARRIER } }
