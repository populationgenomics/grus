id: "twins_marry_cousins_apart"
labels { text: "A twin's child marries a cousin: the twins' chain must stand reversed" kind: LABEL_KIND_OTHER }
individuals { generation: 1 index: 1 gender: GENDER_MAN }
individuals { generation: 1 index: 2 gender: GENDER_WOMAN }
individuals { generation: 2 index: 1 gender: GENDER_MAN }
individuals { generation: 2 index: 2 gender: GENDER_MAN }
individuals { generation: 2 index: 3 gender: GENDER_MAN }
individuals { generation: 2 index: 4 gender: GENDER_WOMAN }
individuals { generation: 2 index: 5 gender: GENDER_WOMAN }
individuals { generation: 2 index: 6 gender: GENDER_WOMAN }
individuals { generation: 3 index: 1 gender: GENDER_MAN }
individuals { generation: 3 index: 2 gender: GENDER_MAN }
individuals { generation: 3 index: 3 gender: GENDER_WOMAN }
individuals { generation: 3 index: 4 gender: GENDER_MAN }
individuals { generation: 3 index: 5 gender: GENDER_WOMAN }
matings { partner_a { generation: 1 index: 1 } partner_b { generation: 1 index: 2 } offspring { child { generation: 2 index: 1 } twin_group: 1 twin_type: ZYGOSITY_TYPE_DIZYGOTIC } offspring { child { generation: 2 index: 2 } twin_group: 1 twin_type: ZYGOSITY_TYPE_DIZYGOTIC } offspring { child { generation: 2 index: 3 } } }
matings { partner_a { generation: 2 index: 2 } partner_b { generation: 2 index: 4 } offspring { child { generation: 3 index: 1 } } }
matings { partner_a { generation: 2 index: 1 } partner_b { generation: 2 index: 5 } offspring { child { generation: 3 index: 2 } } offspring { child { generation: 3 index: 3 } } }
matings { partner_a { generation: 2 index: 3 } partner_b { generation: 2 index: 6 } offspring { child { generation: 3 index: 4 } } offspring { child { generation: 3 index: 5 } } }
matings { partner_a { generation: 3 index: 4 } partner_b { generation: 3 index: 3 } consanguineous: true }
