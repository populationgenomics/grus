id: "sibship"
labels { text: "A sibship of four in birth order, mixed gender and status" kind: LABEL_KIND_OTHER }
individuals { generation: 1 index: 1 gender: GENDER_MAN }
individuals { generation: 1 index: 2 gender: GENDER_WOMAN }
individuals { generation: 2 index: 1 gender: GENDER_MAN conditions { status: CONDITION_STATUS_AFFECTED } annotations { text: "M/M" type: ANNOTATION_TYPE_GENOTYPE } }
individuals { generation: 2 index: 2 gender: GENDER_WOMAN }
individuals { generation: 2 index: 3 gender: GENDER_UNKNOWN conditions { status: CONDITION_STATUS_UNKNOWN } }
individuals { generation: 2 index: 4 gender: GENDER_WOMAN conditions { status: CONDITION_STATUS_CARRIER } annotations { text: "N/M" type: ANNOTATION_TYPE_GENOTYPE } }
matings { partner_a { generation: 1 index: 1 } partner_b { generation: 1 index: 2 } offspring { child { generation: 2 index: 1 } } offspring { child { generation: 2 index: 2 } } offspring { child { generation: 2 index: 3 } } offspring { child { generation: 2 index: 4 } } }
