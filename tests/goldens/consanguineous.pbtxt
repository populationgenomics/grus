id: "consanguineous"
labels { text: "A consanguineous mating (double line), no drawn common ancestor" kind: LABEL_KIND_OTHER }
individuals { generation: 1 index: 1 gender: GENDER_MAN }
individuals { generation: 1 index: 2 gender: GENDER_WOMAN }
individuals { generation: 2 index: 1 gender: GENDER_UNKNOWN conditions { status: CONDITION_STATUS_AFFECTED } conditions { status: CONDITION_STATUS_CARRIER } }
matings { partner_a { generation: 1 index: 1 } partner_b { generation: 1 index: 2 } consanguineous: true offspring { child { generation: 2 index: 1 } } }
