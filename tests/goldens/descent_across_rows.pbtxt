id: "descent_across_rows"
labels { text: "A child drawn two rows below its parents, beside its half-siblings' cousins" kind: LABEL_KIND_OTHER }
individuals { generation: 1 index: 1 gender: GENDER_MAN conditions { status: CONDITION_STATUS_AFFECTED } }
individuals { generation: 1 index: 2 gender: GENDER_WOMAN }
individuals { generation: 1 index: 3 gender: GENDER_WOMAN }
individuals { generation: 2 index: 1 gender: GENDER_MAN }
individuals { generation: 2 index: 2 gender: GENDER_WOMAN }
individuals { generation: 3 index: 1 gender: GENDER_WOMAN conditions { status: CONDITION_STATUS_AFFECTED } }
individuals { generation: 3 index: 2 gender: GENDER_MAN }
individuals { generation: 3 index: 3 gender: GENDER_WOMAN }
matings { partner_a { generation: 1 index: 1 } partner_b { generation: 1 index: 2 } offspring { child { generation: 2 index: 1 } } }
matings { partner_a { generation: 1 index: 1 } partner_b { generation: 1 index: 3 } offspring { child { generation: 3 index: 1 } } }
matings { partner_a { generation: 2 index: 1 } partner_b { generation: 2 index: 2 } offspring { child { generation: 3 index: 2 } } offspring { child { generation: 3 index: 3 } } }
