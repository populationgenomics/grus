conditions { id: "cf" name: "CF" inheritance: INHERITANCE_AUTOSOMAL_RECESSIVE }
conditions { id: "dmd" name: "DMD" inheritance: INHERITANCE_X_LINKED_RECESSIVE }
conditions { id: "unnamed" }
pedigrees {
  id: "carrier-inheritance"
