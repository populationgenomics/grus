  individuals { generation: 1 index: 2 gender: GENDER_WOMAN conditions { condition_id: "dmd" status: CONDITION_STATUS_CARRIER } }
  individuals { generation: 1 index: 3 gender: GENDER_WOMAN conditions { condition_id: "unnamed" status: CONDITION_STATUS_AFFECTED } }
}
