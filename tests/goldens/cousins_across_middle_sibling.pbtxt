individuals { generation: 3 index: 2 gender: GENDER_WOMAN deceased: true }
individuals { generation: 4 index: 1 gender: GENDER_MAN }
individuals { generation: 4 index: 2 gender: GENDER_WOMAN }
individuals { generation: 4 index: 3 gender: GENDER_MAN }
individuals { generation: 4 index: 4 gender: GENDER_WOMAN deceased: true }
individuals { generation: 5 index: 1 gender: GENDER_MAN }
individuals { generation: 5 index: 2 gender: GENDER_MAN }
individuals { generation: 4 index: 5 gender: GENDER_MAN }
individuals { generation: 5 index: 3 gender: GENDER_WOMAN }
individuals { generation: 4 index: 6 gender: GENDER_WOMAN deceased: true }
individuals { generation: 5 index: 4 gender: GENDER_WOMAN conditions { status: CONDITION_STATUS_AFFECTED } }
individuals { generation: 5 index: 5 gender: GENDER_WOMAN conditions { status: CONDITION_STATUS_AFFECTED } }
matings { partner_a { generation: 1 index: 1 } partner_b { generation: 1 index: 2 } offspring { child { generation: 2 index: 1 } } }
matings { partner_a { generation: 2 index: 1 } partner_b { generation: 2 index: 2 } offspring { child { generation: 3 index: 1 } } }
matings { partner_a { generation: 3 index: 1 } partner_b { generation: 3 index: 2 } offspring { child { generation: 4 index: 1 } } offspring { child { generation: 4 index: 2 } } offspring { child { generation: 4 index: 3 } } }
