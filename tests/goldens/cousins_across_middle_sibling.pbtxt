id: "cousins_across_middle_sibling"
labels { text: "First cousins marry across a middle sibling's family: the two lines are seeded at facing ends" kind: LABEL_KIND_OTHER }
individuals { generation: 1 index: 1 gender: GENDER_MAN }
individuals { generation: 1 index: 2 gender: GENDER_WOMAN }
individuals { generation: 2 index: 1 gender: GENDER_WOMAN }
individuals { generation: 2 index: 2 gender: GENDER_MAN }
