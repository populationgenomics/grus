matings { partner_a { generation: 4 index: 2 } partner_b { generation: 4 index: 5 } offspring { child { generation: 5 index: 3 } } }
matings { partner_a { generation: 4 index: 3 } partner_b { generation: 4 index: 6 } offspring { child { generation: 5 index: 4 } } offspring { child { generation: 5 index: 5 } } }
